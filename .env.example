# Database connection string (Postgres)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5433/amazonadc

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Contact form spam protection
# Signed token + honeypot + rate limit + origin check are always on.
# Optional Cloudflare Turnstile (recommended in production):
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Extra allowed origins for the contact API (comma-separated), besides NEXT_PUBLIC_SERVER_URL:
# FORM_ALLOWED_ORIGINS=https://amazonadc.com,https://www.amazonadc.com

# Form notification emails (Forms → Emails in admin). Delivery:
# RESEND_API_KEY=
# EMAIL_FROM_NAME=Amazon Air Duct Cleaning
# EMAIL_FROM_ADDRESS=support@amazonadc.com
# Fallback inbox if a Form has no Emails tab entries:
# CONTACT_TO_EMAIL=support@amazonadc.com
